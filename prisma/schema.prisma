// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  CHILD
}

enum Tier {
  BASIC
  PREMIUM
  ULTRA
}

enum Market {
  TASI
  NASDAQ
}

enum Currency {
  SAR
  USD
}

// DR-17 age gate. Ordinal via src/academy/schema.ts AGE_SEGMENT_RANK
// (KIDS < TEENS < ADULTS). Nullable: a CHILD with no segment set is
// treated as KIDS (fail-closed, most protective); PARENT-role accounts
// see everything regardless of this field.
enum AgeSegment {
  KIDS
  TEENS
  ADULTS
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  QUEST_REWARD
  ALLOWANCE
  PROFIT_SHARE
  INCUBATION_TRADE
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  name      String
  role      Role     @default(CHILD)
  tier      Tier     @default(BASIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rushd Quant: virtual (play-money) buying power for the paper committee.
  cashVirtual Decimal @default(100000) @db.Decimal(18, 4)

  passwordHash     String?
  username         String?
  familyCode       String?   @unique
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  parentId   String?
  parent     User?       @relation("FamilyMembers", fields: [parentId], references: [id])
  children   User[]      @relation("FamilyMembers")
  // DR-17: parent-set on CHILD accounts at create/settings. Null on CHILD
  // means "not yet set" and is treated as KIDS by the segment gate.
  ageSegment AgeSegment?

  gamificationProfile      GamificationProfile?
  portfolioItems           PortfolioItem[]
  transactions             Transaction[]
  savingsJar               SavingsJar?
  quizAttempts             QuizAttempt[]
  strategyLearningAttempts StrategyLearningAttempt[]
  strategies               Strategy[]
  decisions                Decision[]
  purificationEntries      PurificationEntry[]
  academyProgress          AcademyProgress[]
  learnerProfile           LearnerProfile?

  @@unique([parentId, username])
  @@index([parentId])
}

model GamificationProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp        Int      @default(0)
  level     Int      @default(1)
  badges    String[]
  updatedAt DateTime @updatedAt
}

model PortfolioItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  shares    Decimal  @db.Decimal(18, 6)
  market    Market
  currency  Currency
  costBasis Decimal? @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(18, 4)
  currency    Currency        @default(SAR)
  type        TransactionType
  mcc         String?
  description String?
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
}

model SavingsJar {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance             Decimal  @default(0.0) @db.Decimal(18, 4)
  currency            Currency @default(SAR)
  profitShareRatioBps Int      @default(7000)
  updatedAt           DateTime @updatedAt
}

model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String // e.g., "Stock Market Basics"
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Rushd Academy (M12/DR-17) progress. Content itself is code-resident
// (src/academy/**); this row is the only DB-persisted state per lesson.
// The unique constraint is the idempotency key for the completion API —
// a repeat completion updates this row rather than inserting a second one,
// so XP is granted at most once per (userId, trackId, unitId, lessonId).
model AcademyProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId        String
  unitId         String
  lessonId       String
  status         String // 'COMPLETED' — reserved for future 'IN_PROGRESS' states
  score          Int?
  answers        Json?
  contentVersion Int
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, trackId, unitId, lessonId])
  @@index([userId])
}

// DR-19 diagnostic/adaptive-learning profile. Additive to AcademyProgress —
// this row is the single feedback-loop target (`signals`) fed by the
// progress-completion API and the single source persona/skillLevel are read
// from. Age is NEVER stored here (see src/academy/diagnostic — the scorer
// only ever receives an `isChild` boolean, never age/birthdate).
model LearnerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona           String
  baselineKnowledge Int
  skillLevel        Int
  diagnosticAnswers Json     @default("{}")
  signals           Json     @default("{}")
  profileVersion    Int
  updatedAt         DateTime @updatedAt
}

// Immutable sealed learner policy. Replay output is stored separately so this row is never updated
// after `sealedAt`; a retry always inserts a new numbered attempt (SYSTEM_DESIGN DR-14 / M10 L3).
model StrategyLearningAttempt {
  id                 String                         @id @default(uuid())
  userId             String
  user               User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  setupId            String
  setupVersion       String
  questionSetVersion String
  policyVersion      String
  policyHash         String
  complianceTag      String
  attemptNumber      Int
  idempotencyKey     String
  answers            Json
  compiledPolicy     Json
  replayConfig       Json
  dataProvenance     Json
  retryOfId          String?
  retryOf            StrategyLearningAttempt?       @relation("StrategyLearningRetries", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries            StrategyLearningAttempt[]      @relation("StrategyLearningRetries")
  sealedAt           DateTime
  createdAt          DateTime                       @default(now())
  result             StrategyLearningResult?
  masteryEvents      StrategyLearningMasteryEvent[]

  @@unique([userId, idempotencyKey])
  @@unique([userId, setupId, attemptNumber])
  @@index([userId, createdAt])
  @@index([retryOfId])
}

// Created only after its parent attempt is sealed. Unique attemptId makes completion idempotent.
model StrategyLearningResult {
  id        String                  @id @default(uuid())
  attemptId String                  @unique
  attempt   StrategyLearningAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime                @default(now())
}

// Process-only learning rewards. One row per milestone makes XP idempotent and auditable;
// `xp` is fixed by server policy and never derived from replay returns (DR-14 / M10 L5).
model StrategyLearningMasteryEvent {
  id        String                  @id @default(uuid())
  attemptId String
  attempt   StrategyLearningAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  kind      String
  response  String?
  correct   Boolean?
  xp        Int
  createdAt DateTime                @default(now())

  @@unique([attemptId, kind])
  @@index([attemptId, createdAt])
}

// ── Rushd Quant: data spine (Q0). All quantity/price fields Decimal.
// Point-in-time keys: MarketBar.ts, Fundamentals.releasedAt, NewsItem.publishedAt
// — nothing dated after a decision's `asOf` may ever reach an analyst (no look-ahead).

enum BarInterval {
  DAY
  HOUR
  MINUTE
}

enum DataSource {
  MOCK
  YAHOO
  ALPACA
  SAHMK
  TWELVEDATA
  ZOYA
  FUNDAMENTALS
}

model MarketBar {
  id        String      @id @default(uuid())
  symbol    String
  market    Market
  interval  BarInterval @default(DAY)
  ts        DateTime // bar close time (UTC) — the point-in-time key
  open      Decimal     @db.Decimal(18, 6)
  high      Decimal     @db.Decimal(18, 6)
  low       Decimal     @db.Decimal(18, 6)
  close     Decimal     @db.Decimal(18, 6)
  volume    Decimal     @db.Decimal(24, 4)
  source    DataSource
  createdAt DateTime    @default(now())

  @@unique([symbol, market, interval, ts])
  @@index([symbol, market, interval, ts])
}

// ── Rushd Quant: intraday data spine (QDR-6 / G1). Additive; NASDAQ-only first.
// IntradayBar mirrors MarketBar's PIT contract at 1-minute granularity (incl. premarket/
// postmarket, tagged via `session`). SymbolSnapshot is a derived, point-in-time-stamped
// rollup (mcap/float/premarket move/cumulative volume) consumed by the gapper-momentum
// strategy lane (G2) — never written by hand, always computed from IntradayBar + Fundamentals.
// Same no-look-ahead discipline as MarketBar: reads go through pointInTime.ts exclusively.
enum IntradaySession {
  PRE
  REGULAR
  POST
}

model IntradayBar {
  id        String          @id @default(uuid())
  symbol    String
  market    Market
  ts        DateTime // bar close time (UTC, 1-min granularity) — the point-in-time key
  open      Decimal         @db.Decimal(18, 6)
  high      Decimal         @db.Decimal(18, 6)
  low       Decimal         @db.Decimal(18, 6)
  close     Decimal         @db.Decimal(18, 6)
  volume    Decimal         @db.Decimal(24, 4)
  session   IntradaySession
  source    DataSource
  createdAt DateTime        @default(now())

  @@unique([symbol, market, ts])
  @@index([symbol, market, ts])
}

model SymbolSnapshot {
  id               String      @id @default(uuid())
  symbol           String
  market           Market
  asOf             DateTime // the point-in-time key
  mcap             Decimal?    @db.Decimal(24, 4)
  float            Decimal?    @db.Decimal(24, 4)
  premarketMovePct Decimal?    @db.Decimal(9, 4)
  cumVolume        Decimal     @db.Decimal(24, 4)
  source           DataSource // provenance of premarketMovePct/cumVolume bars
  mcapSource       DataSource? // separate provenance for mcap; null when mcap is unavailable
  createdAt        DateTime    @default(now())

  @@unique([symbol, market, asOf])
  @@index([symbol, market, asOf])
}

// ANNUAL = a 10-K fiscal-year filing; QUARTERLY = a 10-Q fiscal-quarter (Q1/Q2/Q3) filing.
// A real schema-level discriminator (not just `metrics.form`) so a quarterly and an annual row
// for the same symbol can never collide under `@@unique` and a reader can never mistake one for
// the other without parsing JSON. Defaults existing rows (all pre-dating this column, all 10-K)
// to ANNUAL — additive, no existing row's meaning changes.
enum FundamentalsPeriod {
  ANNUAL
  QUARTERLY
}

model Fundamentals {
  id         String             @id @default(uuid())
  symbol     String
  market     Market
  asOf       DateTime // the fiscal period the metrics describe
  releasedAt DateTime // when the data became public — the point-in-time key
  period     FundamentalsPeriod @default(ANNUAL) // schema-level ANNUAL/QUARTERLY discriminator
  metrics    Json // { peRatio, debtToMarketCap, revenue, form, fp, ... } — typed accessors in code
  source     DataSource
  createdAt  DateTime           @default(now())

  @@unique([symbol, market, asOf, period])
  @@index([symbol, market, releasedAt])
}

model NewsItem {
  id          String     @id @default(uuid())
  symbol      String
  market      Market
  publishedAt DateTime // the point-in-time key
  headline    String
  summary     String?
  url         String?
  sentiment   Decimal?   @db.Decimal(4, 3) // -1..1, optional
  source      DataSource
  createdAt   DateTime   @default(now())

  @@index([symbol, market, publishedAt])
}

// ── Rushd Quant: committee, decisions & orders (Q1). QUANT_DESIGN.md §4.
// Additive; money/qty Decimal. A paper fill also writes a Transaction(type=TRADE)
// for audit continuity. AgentKind/Stance mirror the TS union in src/quant/types.ts.

enum AgentKind {
  QUANT_CORE
  NEWS_CATALYST
  TECHNICAL
  PATTERN_ANALOG
  SHARIA
  FUNDAMENTAL
  RESEARCH
  PORTFOLIO_MANAGER
}

enum Stance {
  BULLISH
  BEARISH
  NEUTRAL
}

enum AutonomyTier {
  HUMAN_APPROVE
  AUTO_PAPER
  AUTO_REAL
  INCUBATION_PAPER
}

enum DecisionMode {
  HUMAN_APPROVE
  AUTO_PAPER
  AUTO_REAL
  INCUBATION_PAPER
}

enum DecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  VETOED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  NEW
  PARTIAL
  FILLED
  CANCELLED
  REJECTED
}

enum BrokerKind {
  ALPACA_PAPER
  INTERNAL_SIM
}

model Strategy {
  id           String       @id @default(uuid())
  ownerUserId  String
  owner        User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name         String
  market       Market
  config       Json
  autonomyTier AutonomyTier @default(HUMAN_APPROVE)
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  decisions    Decision[]

  @@index([ownerUserId])
}

model Decision {
  id               String                @id @default(uuid())
  strategyId       String?
  strategy         Strategy?             @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol           String
  market           Market
  asOf             DateTime
  proposedAction   String // BUY | SELL | HOLD
  proposedQty      Decimal               @db.Decimal(18, 6)
  finalAction      String
  finalQty         Decimal               @db.Decimal(18, 6)
  shariaGate       Json
  riskAdjustments  Json
  debateTranscript Json
  pmModelId        String?
  temperature      Decimal               @db.Decimal(4, 3)
  seed             Int
  gitSha           String?
  mode             DecisionMode
  status           DecisionStatus        @default(PROPOSED)
  costCents        Int                   @default(0)
  createdAt        DateTime              @default(now())
  signals          AnalystSignalRecord[]
  order            Order?

  @@index([userId, createdAt])
}

model AnalystSignalRecord {
  id          String    @id @default(uuid())
  decisionId  String
  decision    Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  agent       AgentKind
  symbol      String
  stance      Stance
  conviction  Decimal   @db.Decimal(5, 4)
  horizonDays Int
  rationaleEn String
  rationaleAr String
  evidence    Json
  determinism String // 'deterministic' | 'llm'
  modelId     String?
  failureMode String // 'ok' | 'degraded' | 'abstain'
  costCents   Int       @default(0)

  @@index([decisionId])
}

model Order {
  id           String      @id @default(uuid())
  decisionId   String      @unique
  decision     Decision    @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  brokerRef    String?
  symbol       String
  market       Market
  side         OrderSide
  qty          Decimal     @db.Decimal(18, 6)
  limitPrice   Decimal?    @db.Decimal(18, 6)
  filledQty    Decimal     @default(0) @db.Decimal(18, 6)
  avgFillPrice Decimal     @default(0) @db.Decimal(18, 6)
  status       OrderStatus @default(NEW)
  broker       BrokerKind
  createdAt    DateTime    @default(now())

  @@index([status])
}

model PortfolioSnapshot {
  id               String   @id @default(uuid())
  strategyId       String
  userId           String
  asOf             DateTime
  cashVirtual      Decimal  @db.Decimal(18, 4)
  currency         Currency @default(SAR)
  positions        Json // symbol -> { qty, costBasis }
  nav              Decimal  @db.Decimal(18, 4)
  benchmarkNavSpy  Decimal  @default(100.0) @db.Decimal(18, 4)
  benchmarkNavSpus Decimal  @default(100.0) @db.Decimal(18, 4)

  @@index([strategyId, asOf])
}

// Rushd Quant: reproducibility record for a backtest (QUANT_DESIGN §4, Q2).
// metrics = { cagr, sharpe, deflatedSharpe, maxDrawdown, hitRate, trades, turnover }.
model BacktestRun {
  id            String   @id @default(uuid())
  strategyId    String?
  symbol        String
  market        Market
  fromDate      DateTime
  toDate        DateTime
  oosFraction   Decimal  @db.Decimal(4, 3)
  metrics       Json
  implausible   Boolean  @default(false)
  pmSurrogateId String
  seed          Int
  gitSha        String?
  createdAt     DateTime @default(now())

  @@index([strategyId, createdAt])
}

// Rushd Quant: the kill-switch (QUANT_DESIGN §7, Q6). A single row (id="singleton").
// Checked at the top of every automated run and before any auto-execution.
model QuantControl {
  id        String   @id @default("singleton")
  halted    Boolean  @default(false)
  reason    String?
  updatedAt DateTime @updatedAt
}

// Rushd Quant — per-(day, strategy, symbol) claim (QUANT_DESIGN §7). The unique key is the
// race-safety primitive for the automated run: two concurrent cron fires racing to claim the
// same unit produce one winner (insert succeeds) and one loser (P2002), so a unit is never
// run twice. Independent per unit, so a partial/timed-out run resumes cleanly next fire.
model AutoRunClaim {
  key       String   @id
  createdAt DateTime @default(now())
}

// QDR-7/QDR-8 — one auditable daily capital split across isolated paper books.
model AllocationDecision {
  id          String   @id @default(uuid())
  asOf        DateTime
  windowDays  Int      @default(63)
  seed        Int
  gitSha      String?
  inputs      Json
  scores      Json
  allocations Json
  benched     String[]
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([asOf])
}

// QDR-8 — nightly per-book marks. B2 owns population and auto-bench transitions.
model BookEvaluation {
  id                   String   @id @default(uuid())
  bookId               String
  asOf                 DateTime
  nav                  Decimal  @db.Decimal(18, 4)
  dailyPnl             Decimal  @db.Decimal(18, 4)
  drawdown             Decimal  @db.Decimal(8, 6)
  trackingError        Decimal  @db.Decimal(8, 6)
  benchFlags           String[]
  benched              Boolean  @default(false)
  requiresRevalidation Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@unique([bookId, asOf])
  @@index([bookId, asOf])
}

// Rushd Quant: research/literature corpus for the RAG analyst (QUANT_DESIGN §4, Q4).
// embedding is optional — MVP retrieval is keyword/tag based (no embedding API needed).
model ResearchDoc {
  id        String   @id @default(uuid())
  title     String
  sourceRef String
  text      String
  tags      String[]
  embedding Float[]
  createdAt DateTime @default(now())

  @@index([tags])
}

// M17/DR-11 — broker-neutral SHADOW_PAPER operational mirror (QUANT_DESIGN.md QDR-8
// operational-mirror amendment). These two models are DELIBERATELY disconnected from every
// promotion-evidence model (Strategy, Decision, BookEvaluation, AllocationDecision): no
// relation field here targets them, and none of them declares a back-relation here, so no
// Prisma include/join path can pull a shadow row into allocator input, a card, or the
// >=63-book-day series. `bookId`/`decisionId` are plain strings (like BookEvaluation.bookId),
// never foreign keys, for the same reason. Real submission stays gated in code
// (src/quant/execution/registry.ts, shadowPaperRunner.ts) — these models only make the
// resulting evidence durable and idempotent.
enum ShadowPaperRunStatus {
  STARTED
  PREFLIGHT_BLOCKED
  GATE_BLOCKED
  DRY_RUN
  SUBMITTED
  RECONCILED
  FAILED
}

enum ShadowPaperOrderPurpose {
  PROBE_CANCEL
  PROBE_FILL
  FLATTEN
}

model ShadowPaperRun {
  id                 String               @id @default(uuid())
  bookId             String
  strategyVersion    String
  asOf               DateTime
  adapter            BrokerKind
  // One-way, non-secret fingerprint of the broker account (never the raw account id/credentials).
  accountFingerprint String
  preflight          Json
  status             ShadowPaperRunStatus @default(STARTED)
  requestedNotional  Decimal              @db.Decimal(18, 4)
  evidence           Json
  startedAt          DateTime             @default(now())
  finishedAt         DateTime?
  orders             ShadowPaperOrder[]

  // Idempotent run claim: a concurrent double-fire for the same book/version/day/adapter
  // produces one row (insert-or-reuse), never two.
  @@unique([bookId, strategyVersion, asOf, adapter])
}

model ShadowPaperOrder {
  id            String                  @id @default(uuid())
  runId         String
  run           ShadowPaperRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Plain string, no FK — see the models' header comment. Never joined back to Decision.
  decisionId    String?
  // SHA-256 of (bookId, strategyVersion, asOf, decisionId, purpose): the idempotency key
  // that lets a retried/duplicated attempt resolve to the same broker + DB order exactly once.
  clientOrderId String                  @unique
  brokerRef     String?
  symbol        String
  side          OrderSide
  qty           Decimal                 @db.Decimal(18, 6)
  filledQty     Decimal                 @default(0) @db.Decimal(18, 6)
  avgFillPrice  Decimal                 @default(0) @db.Decimal(18, 6)
  status        OrderStatus             @default(NEW)
  purpose       ShadowPaperOrderPurpose
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([runId])
}

model PurificationEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  amount    Decimal  @db.Decimal(18, 4)
  ratio     Decimal  @db.Decimal(6, 4)
  profit    Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Append-only point-in-time record of the eligible halal universe, captured daily going forward.
///
/// WHY THIS EXISTS: the survivorship measurement found 108 of 320 historical symbols absent from
/// the current fixture, and historical membership for 2018-2020 may be unbuyable at any price
/// (docs/quant-experiments/survivorship-coverage-measurement.md ruled DEFER). Nothing can recover
/// that history — but from today forward it is free, and only if capture starts now. A day not
/// captured is permanently absent from the record.
///
/// APPEND-ONLY BY CONTRACT. There is no update or delete path: a mutable membership row is
/// worthless as point-in-time evidence. Idempotency is enforced by the @@unique on
/// (captureDate, symbol, market) plus `skipDuplicates`, never by overwriting.
///
/// EXCLUDED NAMES ARE RECORDED TOO. An excluded symbol at date D is itself evidence — it proves
/// the screen ran and rejected the name, which is a different fact from the name being absent
/// because data was missing.
///
/// IDENTITY CAVEAT: `buildVerifiedUniverse()` does not expose a CIK, so rows are symbol-keyed and
/// `cik` is reserved for later enrichment. Each row is unambiguous on its own because `capturedAt`
/// stamps it, but a FUTURE CONSUMER JOINING ON `symbol` ACROSS TIME could merge two different
/// companies if a ticker is reused. Join on (symbol, captureDate) windows, or backfill `cik`
/// first. This is the same defect class already identified in MarketBar.
model UniverseMembershipCapture {
  id                   String   @id @default(uuid())
  /// The calendar day this capture represents; the idempotency key.
  captureDate          DateTime @db.Date
  /// Server-assigned wall clock at capture. The point-in-time key. Never client-supplied.
  capturedAt           DateTime @default(now())
  symbol               String
  /// Reserved for later enrichment; null today because the universe source does not carry it.
  cik                  String?
  market               Market
  /// true = eligible member at captureDate, false = screened and rejected. Never null.
  included             Boolean
  /// Provenance tier from UniverseEntry, e.g. 'index-provider-screened'.
  tier                 String?
  /// Human-readable source citation, e.g. "SPUS holdings fixture (2026-07-17)".
  provenance           String?
  /// ISO date of the underlying source snapshot, distinct from captureDate.
  sourceAsOf           String?
  /// AAOIFI purification ratio in bps; null when the source does not disclose one (never faked).
  purificationRatioBps Int?
  /// Informational codes carried even for an included name; never hides a caveat.
  reasonCodes          String[]
  /// Populated only when included = false.
  exclusionReason      String?
  /// Hash of the captured payload so a row cannot be silently swapped after the fact.
  contentHash          String
  createdAt            DateTime @default(now())

  @@unique([captureDate, symbol, market])
  @@index([captureDate])
  @@index([symbol, capturedAt])
}
